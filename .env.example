# --- Supabase (https://supabase.com/dashboard -> Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# Vision + assistant model: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Any vision-capable Claude model id
ANTHROPIC_MODEL=claude-sonnet-5-5

# Nutrition database: free key at https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=your-fdc-api-key
